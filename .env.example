# ---------------------------------------------------------------------------
# rental-prices — template. Copy to .env and fill in. Safe to commit.
# ---------------------------------------------------------------------------

# RentCast — rental listings + AVM rent estimates
# Sign up: https://app.rentcast.io/app/api
# Note your plan's monthly request quota; D0 recon should cost ~20-30 calls.
RENTCAST_API_KEY=your_key_here

# US Census Bureau — ACS tract-level income/density joins, and geocoding fallback
# Request a key (free, instant): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_key_here
